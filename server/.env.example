# Server-side configuration. Copy to server/.env locally; never commit that file.
HOST=127.0.0.1
PORT=8080
PRACTICE_ENABLED=false
PILOT_ACCESS_CODE=REPLACE_WITH_RANDOM_32_BYTE_SECRET
GLADIA_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Copy the exact Qwen model URI from your AI Studio project/catalog.
YANDEX_MODEL_URI=gpt://YOUR_FOLDER_ID/YOUR_QWEN_MODEL
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATA_PATH=server/data/practice.sqlite
MAX_AUDIO_SECONDS=15
MAX_TURNS=8
MAX_ASR_JOBS_TOTAL=100
MAX_LLM_CALLS_TOTAL=100
MAX_LLM_OUTPUT_TOKENS=320
MAX_SESSIONS_PER_ACCESS=3
RETENTION_HOURS=24
